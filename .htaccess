<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to hidden files, sensitive configs, and environment files
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|tailwind\.config\.js|\.system_generated) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage/logs|tests|vendor)/ - [F,L,NC]

    # ─── MAP TO PUBLIC DIRECTORY ─────────────────────────────────────────────────
    # Server structure:
    #   public_html/helpofai.com/studio/          ← Laravel app root (this .htaccess)
    #   public_html/helpofai.com/studio/public/   ← Laravel web root (index.php here)
    #
    # Apache's RewriteRule in .htaccess context matches the path RELATIVE to the
    # current directory. For request /studio/login, the pattern sees just "login".
    #
    # If the path is already a real file or directory (e.g. public/build/app.css),
    # skip the rewrite and let Apache serve it directly.
    # Otherwise, forward everything to public/ — public/.htaccess then routes to
    # index.php, and index.php strips /studio from REQUEST_URI before Laravel boots.
    # ─────────────────────────────────────────────────────────────────────────────
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Disable Directory Browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>