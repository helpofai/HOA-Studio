<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Security: block direct access to sensitive files ──────────────────────
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|tailwind\.config\.js|\.system_generated) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage/logs|tests|vendor)/ - [F,L,NC]

    # ── Route to smart router (index.php at app root) ─────────────────────────
    #
    # Server layout:
    #   public_html/helpofai.com/studio/          ← Laravel app root  (this .htaccess + index.php)
    #   public_html/helpofai.com/studio/public/   ← Laravel web root  (assets, install.php, etc.)
    #
    # PATTERN: identical to Laravel's own public/.htaccess — proven and simple.
    #
    # If the requested path is a REAL FILE (e.g. studio/somefile.txt), serve it directly.
    # If the requested path is a REAL DIRECTORY, serve it directly.
    # Everything else → index.php (our smart router) which handles:
    #   • Stripping /studio prefix from REQUEST_URI
    #   • Serving public/ PHP files (install.php, hoa-rescue.php)
    #   • Serving public/ static assets (CSS, JS, images, fonts)
    #   • Passing dynamic routes to Laravel
    # ──────────────────────────────────────────────────────────────────────────
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Disable Directory Browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>